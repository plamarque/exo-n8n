    {
      "parameters": {
        "jsCode": "function parseMaybeEnvelope(raw) {\n  if (Array.isArray(raw) && raw.length && raw[0]?.type === 'text' && typeof raw[0]?.text === 'string') {\n    return JSON.parse(raw[0].text);\n  }\n  if (typeof raw === 'string') return JSON.parse(raw);\n  return raw;\n}\n\nfunction classify(text) {\n  const t = (text || '').toLowerCase();\n  const rules = [\n    { match: 'vpn', priority: 'HIGH', assignee: 'maria', slaHours: 4 },\n    { match: 'acces ged', priority: 'NORMAL', assignee: 'yann', slaHours: 24 },\n    { match: 'plan de circulation', priority: 'HIGH', assignee: 'sarah', slaHours: 6 }\n  ];\n\n  for (const rule of rules) {\n    if (t.includes(rule.match)) return rule;\n  }\n\n  return { priority: 'NORMAL', assignee: $env.EXO_DEFAULT_ASSIGNEE || 'yann', slaHours: 24 };\n}\n\nconst email = parseMaybeEnvelope($json);\nconst body = email?.content?.body || email?.body || '';\nconst subject = email?.subject || 'Email sans sujet';\nconst sender = email?.sender || email?.from || 'unknown';\nconst receivedAt = email?.receivedDate || email?.receivedAt || new Date().toISOString();\n\nconst decision = classify(`${subject} ${body}`);\nconst due = new Date(new Date(receivedAt).getTime() + decision.slaHours * 60 * 60 * 1000).toISOString();\n\nreturn [{\n  json: {\n    rawEmail: email,\n    task: {\n      title: subject,\n      description: `Mail from: ${sender}\\n\\n${body}`.slice(0, 5000),\n      priority: decision.priority,\n      assignee: decision.assignee,\n      dueDate: due,\n      watcherUsernames: ($env.EXO_WATCHERS || 'teamlead_it').split(',').map(v => v.trim()).filter(Boolean),\n      context: 'MAIL'\n    }\n  }\n}];"
      },
