      "parameters": {
        "jsCode": "const seen = getWorkflowStaticData('global');\nif (!seen.processedEmailIds) seen.processedEmailIds = [];\n\nfunction parseMaybeEnvelope(raw) {\n  if (Array.isArray(raw) && raw.length && raw[0]?.type === 'text' && typeof raw[0]?.text === 'string') {\n    return JSON.parse(raw[0].text);\n  }\n  if (typeof raw === 'string') return JSON.parse(raw);\n  return raw;\n}\n\nconst payload = parseMaybeEnvelope($json);\nconst emails = Array.isArray(payload) ? payload : (payload.emails || []);\n\nconst outputs = [];\nfor (const email of emails) {\n  const id = String(email.email_id ?? email.id ?? email.messageId ?? '');\n  if (!id) continue;\n  if (seen.processedEmailIds.includes(id)) continue;\n  outputs.push({ json: { emailId: id } });\n  seen.processedEmailIds.push(id);\n}\n\nif (seen.processedEmailIds.length > 5000) {\n  seen.processedEmailIds = seen.processedEmailIds.slice(-5000);\n}\n\nreturn outputs;"
      },
