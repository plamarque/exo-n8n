      {
        "id": "69a3fedf-08b7-4426-ba00-a06513cd7f46",
        "name": "Prepare Category Assignments",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          5744,
          672
        ],
        "parameters": {
          "jsCode": "const normalize = (s) => String(s || '').replace(/&amp;/g, '&').replace(/\\s+/g, ' ').trim().toLowerCase();\nconst tree = $(\"List Categories\").item.json.content?.[0]?.text;\nconst map = new Map();\nconst walk = (node) => {\n  if (!node) return;\n  if (Array.isArray(node)) return node.forEach(walk);\n  if (node.name && node.category_id != null) map.set(normalize(node.name), node.category_id);\n  if (Array.isArray(node.sub_categories)) walk(node.sub_categories);\n};\nwalk(tree?.sub_categories || tree);\nconst id = map.get(normalize($json.categoryName));\nif (id == null) throw new Error('No category_id match for suggested category: ' + String($json.categoryName));\nreturn [{ json: { ...$json, category_id: id, content_id: $json.documentId, content_type: 'document' } }];"
        }
