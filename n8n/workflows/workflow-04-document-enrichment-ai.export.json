                "type": "string"
              },
              {
                "id": "8",
                "name": "editorUrl",
                "value": "={{ (() => { const docId = $(\"Read Document Content\").item.json.content?.[0]?.text?.document_id || \"\"; return docId ? \"http://exo-qaui.meeds.io/portal/dw/oeditor?docId=\" + encodeURIComponent(docId) : \"\"; })() }}",
