                "type": "string"
              },
              {
                "id": "4",
                "name": "availableCategories",
                "value": "={{ (() => { const root = $(\"List Categories\").item.json.content?.[0]?.text; const names = []; const walk = (n) => { if (!n) return; if (Array.isArray(n)) { n.forEach(walk); return; } if (n.name) names.push(n.name); if (Array.isArray(n.sub_categories)) walk(n.sub_categories); }; walk(root?.sub_categories || root); return [...new Set(names.filter(Boolean))]; })() }}",
                "type": "array"
              },
              {
                "id": "5",
                "name": "updatedDate",
                "value": "={{ $(\"Process Each Document\").item.json.updatedDate }}",
                "type": "string"
