    {
      "id": "d33a69c2-248f-4f5f-baee-ea3bc5f4dc6a",
      "name": "Render Task Description HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4100,
        336
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const esc = (v) => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\\\"/g, '&quot;');\nconst excerpt = String($json.body || '').replace(/\\s+/g, ' ').slice(0, 400);\nconst description = [\n  '<div>',\n  '<p><strong>Email source:</strong> ' + esc($json.sender) + '<br/><strong>Sujet:</strong> ' + esc($json.subject) + '</p>',\n  '<h4>Contexte</h4>',\n  '<p>' + esc($json.summary || 'Synthese non fournie') + '</p>',\n  '<h4>Action attendue</h4>',\n  '<p>' + esc($json.nextAction || 'Analyser et mettre a jour le statut') + '</p>',\n  '<h4>Decision IA</h4>',\n  '<ul>',\n  '<li><strong>Assignee:</strong> ' + esc($json.assigneeLabel || $json.resolvedAssignee) + ' (' + esc($json.resolvedAssignee) + ')</li>',\n  '<li><strong>Priorite:</strong> ' + esc($json.resolvedPriority) + '</li>',\n  '<li><strong>Confiance actionnable:</strong> ' + esc($json.actionConfidence) + '</li>',\n  '<li><strong>Justification:</strong> ' + esc($json.rationale || 'Decision IA') + '</li>',\n  '</ul>',\n  '<h4>Extrait email</h4>',\n  '<blockquote>' + esc(excerpt) + '</blockquote>',\n  '</div>'\n].join('').slice(0, 5000);\nreturn [{\n  json: {\n    ...$json,\n    aiDecision: {\n      clearlyActionable: true,\n      assignee: $json.resolvedAssignee,\n      assigneeLabel: $json.assigneeLabel,\n      priority: $json.resolvedPriority,\n      actionConfidence: $json.actionConfidence,\n      taskTitle: $json.taskTitle,\n      summary: $json.summary,\n      nextAction: $json.nextAction,\n      rationale: $json.rationale\n    },\n    mcpInput: {\n      project_id: 66,\n      title: $json.taskTitle,\n      description,\n      assignee: $json.resolvedAssignee,\n      priority: $json.resolvedPriority\n    }\n  }\n}];"
      }
    },
