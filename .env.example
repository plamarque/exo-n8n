# Copy to `.env` at the repository root (never commit `.env`).
# Used by `npm run deploy:workflow` / `tools/push-workflow-to-n8n-api.mjs`.
# In CI, set the same variable names as pipeline secrets instead of using a file.

# n8n Cloud: https://<YOUR_SUBDOMAIN>.app.n8n.cloud (no trailing slash)
N8N_BASE_URL=https://YOUR_SUBDOMAIN.app.n8n.cloud

# n8n API key (Settings → API in the n8n UI)
N8N_API_KEY=

# Remote workflow ids on your n8n instance (see each workflow SPEC.technical.md / README).
# Leave blank until you map each portfolio workflow to its live id.
N8N_WORKFLOW_ID_WF01=
N8N_WORKFLOW_ID_WF02=
N8N_WORKFLOW_ID_WF03=
N8N_WORKFLOW_ID_WF04=
N8N_WORKFLOW_ID_UNWRAP=

# Optional: when pushing canonical workflow.json via REST, MCP Client nodes have no embedded
# credentials. Set this to the n8n credential id (Settings → Credentials → mcpOAuth2Api) so
# deploy re-attaches OAuth2 to every MCP Client node. If unset and exactly one mcpOAuth2Api
# credential exists on the instance, deploy uses it automatically; otherwise set explicitly.
N8N_MCP_OAUTH2_CREDENTIAL_ID=
N8N_MCP_OAUTH2_CREDENTIAL_NAME=

# Optional: same pattern for OpenAI chat model nodes (lmChatOpenAi) when canonical JSON omits credentials.
N8N_OPENAI_CREDENTIAL_ID=
N8N_OPENAI_CREDENTIAL_NAME=
