# Copy to `.env` at the repository root (never commit `.env`).
# Used by `npm run deploy:workflow` / `tools/push-workflow-to-n8n-api.mjs`.
# In CI, set the same variable names as pipeline secrets instead of using a file.

# n8n Cloud: https://<YOUR_SUBDOMAIN>.app.n8n.cloud (no trailing slash)
N8N_BASE_URL=https://YOUR_SUBDOMAIN.app.n8n.cloud

# n8n API key (Settings → API in the n8n UI)
N8N_API_KEY=

# Remote workflow ids for REST deploy (see each workflow SPEC.technical.md / README).
# Optional when the canonical workflow.json already has a top-level "id" from that n8n tenant.
# Required for exports without root id (e.g. some WF02/WF04 exports) and for unwrap.
N8N_WORKFLOW_ID_WF01=
N8N_WORKFLOW_ID_WF02=
N8N_WORKFLOW_ID_WF03=
N8N_WORKFLOW_ID_WF04=
N8N_WORKFLOW_ID_UNWRAP=

# Optional: WF03 UTIL remote ids when not inferred from parent workflow.json Execute Workflow nodes.
N8N_WORKFLOW_ID_WF03_BUILD_REPORT=
N8N_WORKFLOW_ID_WF03_COMPOSE=

# Optional MCP OAuth2 (mcpOAuth2Api) resolution for REST deploy after merge-by-node-id.
# Priority: N8N_MCP_OAUTH2_CREDENTIAL_ID → N8N_MCP_OAUTH2_RESOLVE_BY_NAME → exactly one mcpOAuth2Api on the instance.
# When ID or RESOLVE_BY_NAME is set, deploy overwrites mcpOAuth2Api on all MCP Client (OAuth2) nodes (fixes stale ids in git).
# When unset and the instance has exactly one mcpOAuth2Api credential, deploy only fills nodes that still lack a reference.
N8N_MCP_OAUTH2_CREDENTIAL_ID=
# Optional label stored in the workflow JSON next to N8N_MCP_OAUTH2_CREDENTIAL_ID (not used for lookup; use RESOLVE_BY_NAME to match by display name).
N8N_MCP_OAUTH2_CREDENTIAL_NAME=
# Exact credential display name as shown in n8n (Settings → Credentials), case-sensitive. Used only when N8N_MCP_OAUTH2_CREDENTIAL_ID is empty.
# Example stable convention: name the tenant credential "EXO MCP" and set (quotes required if the name contains spaces):
# N8N_MCP_OAUTH2_RESOLVE_BY_NAME="EXO MCP"
N8N_MCP_OAUTH2_RESOLVE_BY_NAME=

# Optional fallback only for lmChatOpenAi nodes still missing credentials after merge.
N8N_OPENAI_CREDENTIAL_ID=
N8N_OPENAI_CREDENTIAL_NAME=

# Optional: when /credentials cannot pick a single openAiApi entry, deploy copies {id,name}
# from the first configured lmChatOpenAi on this remote workflow (defaults to N8N_WORKFLOW_ID_WF01 when set).
N8N_OPENAI_REFERENCE_WORKFLOW_ID=
