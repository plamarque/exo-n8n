# Copy to `.env` at the repository root (never commit `.env`).
# Used by `npm run deploy:workflow` / `tools/push-workflow-to-n8n-api.mjs`.
# In CI, set the same variable names as pipeline secrets instead of using a file.

# n8n Cloud: https://<YOUR_SUBDOMAIN>.app.n8n.cloud (no trailing slash)
N8N_BASE_URL=https://YOUR_SUBDOMAIN.app.n8n.cloud

# n8n API key (Settings → API in the n8n UI)
N8N_API_KEY=

# eXo MCP base URL — applied to every MCP Client node **in memory** before each REST PUT/POST (deploy.sh),
# and by **`npm run generate:workflow-json`** if you want the same URL written into workflow.json on disk.
# Also referenced in fixture/bootstrap docs. Quote if the URL contains spaces.
# Example: EXO_MCP_ENDPOINT="https://your-tenant.example.com/mcp-server/mcp"
EXO_MCP_ENDPOINT=

# Optional: portfolio keys (WF01_PROJECT_ID, WF02_*, WF03_*, WF04_SPACE_ID, EXO_SPACE_NAME, …) — REST deploy rewrites matching
# `$vars || …` fallback literals in memory before PUT; **`npm run generate:workflow-json`** can persist the same into JSON files.
# Workflow-scoped configuration keys are documented in each `workflows/<workflow>/config.env.example` (e.g.
# WF03_LANGUAGE controls the Analyze Steering Signals agent output language).

# Remote workflow ids for REST deploy: one N8N_WORKFLOW_ID_<SHORTID> per root folder under workflows/
# that has workflows/<folder>/workflow.json. shortId = <folder> before the first "-" (uppercased in the key),
# or the full folder name if there is no hyphen (e.g. unwrap-mcp-json → N8N_WORKFLOW_ID_UNWRAP).
#
# Bootstrap: leave keys unset for a fresh tenant. `./tools/deploy.sh <shortId>` POST-creates the
# workflow on n8n and writes the returned id back here (commenting any prior value with a timestamp).
# Subsequent runs become regular PUT updates. To recreate a workflow from scratch, delete it on n8n
# and clear the matching N8N_WORKFLOW_ID_* line below.
# See docs/DEVELOPMENT.md (Root workflow shortId, Deploy bootstrap).
N8N_WORKFLOW_ID_WF01=
N8N_WORKFLOW_ID_WF02=
N8N_WORKFLOW_ID_WF03=
N8N_WORKFLOW_ID_WF04=
N8N_WORKFLOW_ID_UNWRAP=

# Optional MCP OAuth2 (mcpOAuth2Api) resolution for REST deploy after merge-by-node-id.
# Priority: N8N_MCP_CREDENTIAL_ID → N8N_MCP_CREDENTIAL_NAME (lookup by exact n8n display name when id is unset) → exactly one mcpOAuth2Api on the instance.
# When ID is set, or when NAME alone resolves a unique credential, deploy overwrites mcpOAuth2Api on all MCP Client (OAuth2) nodes (fixes stale ids in git).
# When unset and the instance has exactly one mcpOAuth2Api credential, deploy only fills nodes that still lack a reference.
N8N_MCP_CREDENTIAL_ID=
# With N8N_MCP_CREDENTIAL_ID: optional {name} stored next to that id in workflow JSON (defaults to "MCP OAuth2 API" if empty).
# Without N8N_MCP_CREDENTIAL_ID: exact credential display name in n8n (Settings → Credentials), case-sensitive — used to pick the credential from GET /api/v1/credentials.
# Example name-only convention (quotes if the name contains spaces): N8N_MCP_CREDENTIAL_NAME="EXO MCP"
N8N_MCP_CREDENTIAL_NAME=

# Optional OpenAI (openAiApi) resolution for lmChatOpenAi nodes after merge-by-node-id.
# Priority: N8N_OPENAI_CREDENTIAL_ID → N8N_OPENAI_CREDENTIAL_NAME (exact display name when id is unset) →
# exactly one openAiApi on the instance → if still unresolved, N8N_OPENAI_REFERENCE_WORKFLOW_ID or N8N_WORKFLOW_ID_WF01 (copy ref from another workflow).
# When ID, name-only match, or reference workflow resolves, deploy overwrites openAiApi on all lmChatOpenAi nodes.
# When unset and the instance has exactly one openAiApi credential, deploy only fills nodes that still lack a reference.
N8N_OPENAI_CREDENTIAL_ID=
# With N8N_OPENAI_CREDENTIAL_ID: optional {name} stored next to that id in workflow JSON (defaults to "OpenAI API" if empty).
# Without N8N_OPENAI_CREDENTIAL_ID: exact credential display name in n8n (Settings → Credentials), case-sensitive.
N8N_OPENAI_CREDENTIAL_NAME=

# Optional: reuse an OpenAI credential already attached to another remote workflow.
# Use this when several openAiApi credentials exist and you want this workflow to use the same binding
# as a known workflow. Deploy GETs that workflow, reads the first lmChatOpenAi credentials.openAiApi
# {id,name}, then force-applies it to this workflow. Defaults to N8N_WORKFLOW_ID_WF01 when set.
# Example: N8N_OPENAI_REFERENCE_WORKFLOW_ID=<remote WF01 workflow id>
N8N_OPENAI_REFERENCE_WORKFLOW_ID=
