    {
      "id": "9d6d0ca6-a0de-46f3-bbfa-3565e44f10d0",
      "name": "MCP Search Folder Docs",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1,
      "position": [
        480,
        200
      ],
      "parameters": {
        "endpointUrl": "={{$vars.EXO_MCP_ENDPOINT}}",
        "authentication": "mcpOAuth2Api",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "search_documents"
        },
        "inputMode": "json",
        "jsonInput": "={{ { query: \"\", parent_folder_id: ($vars.WF02_PARENT_FOLDER_ID || \"b468cb5639805e11480baa56164da90c\"), limit: 100, offset: 0 } }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "251c94a2-f04d-4f66-98ab-ff1deb110e81",
      "name": "Parse + Deduplicate Docs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const seen = $getWorkflowStaticData('global');\nif (!Array.isArray(seen.wf02ProcessedDocKeys)) seen.wf02ProcessedDocKeys = [];\n\nconst first = $input.first().json;\nlet payload = first;\nif (first?.content?.[0]?.text !== undefined) payload = first.content[0].text;\nif (Array.isArray(payload) && payload[0]?.type === 'text' && typeof payload[0]?.text === 'string') payload = JSON.parse(payload[0].text);\nelse if (typeof payload === 'string') payload = JSON.parse(payload);\n\nconst docs = Array.isArray(payload) ? payload : (payload?.documents || []);\nconst out = [];\nfor (const doc of docs) {\n  const docId = String(doc.document_id || '').trim();\n  if (!docId) continue;\n  const key = docId + ':' + String(doc.updated_date || '');\n  if (seen.wf02ProcessedDocKeys.includes(key)) continue;\n  seen.wf02ProcessedDocKeys.push(key);\n  out.push({ json: { document_id: docId, cycle_id: key } });\n}\nif (seen.wf02ProcessedDocKeys.length > 5000) seen.wf02ProcessedDocKeys = seen.wf02ProcessedDocKeys.slice(-5000);\nreturn out;"
      }
    },
    {
      "id": "d06c3f8f-61ff-47f8-84ee-2481db4c5fe7",
      "name": "MCP Get Document By ID",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1,
      "position": [
        980,
        200
      ],
      "parameters": {
        "endpointUrl": "={{$vars.EXO_MCP_ENDPOINT}}",
        "authentication": "mcpOAuth2Api",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "get_document_by_id"
        },
        "inputMode": "json",
        "jsonInput": "={{ { document_id: $json.document_id } }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "aa5b4f7c-41dd-4cce-85f1-9fa7756b7c1e",
      "name": "Build Task Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const fromList = $('Parse + Deduplicate Docs').item.json;\nlet payload = $json;\nif ($json?.content?.[0]?.text !== undefined) payload = $json.content[0].text;\nif (Array.isArray(payload) && payload[0]?.type === 'text' && typeof payload[0]?.text === 'string') payload = JSON.parse(payload[0].text);\nelse if (typeof payload === 'string') payload = JSON.parse(payload);\n\nconst doc = payload || {};\nconst documentId = String(doc.document_id || fromList.document_id || '').trim();\nif (!documentId) throw new Error('Missing document_id');\nconst cycleId = fromList.cycle_id || (documentId + ':' + String(doc.updated_date || new Date().toISOString()));\nconst titleCore = String(doc.name || 'Untitled document').replace(/\\.[^.]+$/, '').replace(/[_-]+/g, ' ').trim();\nconst title = ('Validation - ' + titleCore).slice(0, 140);\nconst author = String(doc?.created_username?.username || 'claire').trim() || 'claire';\nconst docUrl = (doc.url && String(doc.url).startsWith('http')) ? String(doc.url) : ('https://exo-mips-ft.meeds.io' + String(doc.url || ''));\n\nconst description = '<p><strong>Source document:</strong> <a href=\"' + docUrl + '\" target=\"_blank\" rel=\"noopener noreferrer\">' + String(doc.name || documentId) + '</a></p>' + '<p><strong>Cycle:</strong> ' + cycleId + '</p>' + '<p><strong>Validation:</strong> use the approval links in the first task comment.</p>' + '<p>Rule: move to Done only when both stamps are APPROVED.</p>';\n\nreturn { document_id: documentId, cycle_id: cycleId, author_username: author, createTaskInput: { project_id: Number($vars.WF02_PROJECT_ID || 117), title, description, assignee: author, coworkers: ['nadia','etienne'], status_id: Number($vars.WF02_INPROGRESS_STATUS_ID || 475), priority: 'NORMAL' } };\n"
      }
    },
    {
      "id": "aeff4690-23b9-461d-8b64-ec0ed8271dff",
      "name": "MCP Create Task",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1,
      "position": [
        1500,
        200
      ],
      "parameters": {
        "endpointUrl": "={{$vars.EXO_MCP_ENDPOINT}}",
        "authentication": "mcpOAuth2Api",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "create_task_in_project"
        },
        "inputMode": "json",
        "jsonInput": "={{$json.createTaskInput}}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "5420c9d5-210d-4d01-9417-d860286d14e2",
      "name": "Extract Task ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const fromBuild = $('Build Task Payload').item.json;\nlet payload = $json;\nif ($json?.content?.[0]?.text !== undefined) payload = $json.content[0].text;\nif (Array.isArray(payload) && payload[0]?.type === 'text' && typeof payload[0]?.text === 'string') payload = JSON.parse(payload[0].text);\nelse if (typeof payload === 'string') payload = JSON.parse(payload);\nconst taskId = Number(payload?.task_id || payload?.id || payload?.task?.task_id || 0);\nif (!taskId) throw new Error('No task_id');\nreturn { ...fromBuild, task_id: taskId };"
      }
    },
    {
      "id": "9d988422-9a5d-41e8-8848-e898e206025a",
      "name": "MCP Add Initial Comment",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1,
      "position": [
        2020,
        200
      ],
      "parameters": {
        "endpointUrl": "={{$vars.EXO_MCP_ENDPOINT}}",
        "authentication": "mcpOAuth2Api",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "add_task_comment"
        },
        "inputMode": "json",
        "jsonInput": "={{ (() => { const base = String($vars.WF02_APPROVAL_BASE_URL || \"https://meeds.app.n8n.cloud/webhook/wf02-doc-validation/approve\").replace(/\\/$/, \"\"); const art = base + \"?task_id=\" + $json.task_id + \"&cycle_id=\" + encodeURIComponent($json.cycle_id) + \"&role=artistic&actor=nadia\"; const tech = base + \"?task_id=\" + $json.task_id + \"&cycle_id=\" + encodeURIComponent($json.cycle_id) + \"&role=technical&actor=etienne\"; const text = \"<p><strong>Validation started</strong> (cycle: \" + $json.cycle_id + \").</p><p><a href=\\\"\" + art + \"\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\">Approve — Artistic (Nadia)</a></p><p><a href=\\\"\" + tech + \"\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\">Approve — Technical (Etienne)</a></p>\"; return { task_id: $json.task_id, text }; })() }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "56693cbc-0d87-42de-952f-c74efef6f95e",
      "name": "Register Approval State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2280,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const state = $getWorkflowStaticData('global');\nif (!state.wf02Approvals) state.wf02Approvals = {};\nconst key = String($json.task_id) + ':' + String($json.cycle_id);\nstate.wf02Approvals[key] = { task_id: $json.task_id, cycle_id: $json.cycle_id, document_id: $json.document_id, author_username: $json.author_username, approvals: { artistic: { actor: 'nadia', decision: 'PENDING', reason: '', at: '' }, technical: { actor: 'etienne', decision: 'PENDING', reason: '', at: '' } } };\nreturn $json;"
      }
    },
    {
      "id": "e08bc8c4-3ef3-468b-9f43-1314eb143cc6",
      "name": "Approval Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        220,
        620
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "wf02-doc-validation/approve",
        "responseMode": "responseNode",
        "authentication": "none"
      },
      "webhookId": "ca8ca31c-e44a-4cb4-8e8f-14b7db56958a"
    },
    {
      "id": "349ac036-e76f-43fb-9df4-2d126eaabc50",
      "name": "Parse Approval",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        620
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $input.first().json || {};\nconst body = input.body || {};\nconst query = input.query || {};\nconst task_id = Number(body.task_id ?? query.task_id ?? 0);\nconst cycle_id = String(body.cycle_id ?? query.cycle_id ?? '');\nconst role = String(body.role ?? query.role ?? '').toLowerCase();\nconst decision = String(body.decision ?? query.decision ?? '').toUpperCase();\nconst reason = String(body.reason ?? query.reason ?? '');\nif (!task_id || !cycle_id || !role || !decision) throw new Error('Invalid approval payload');\nreturn [{ json: { task_id, cycle_id, role, decision, reason } }];"
      }
    },
    {
      "id": "026d243a-4f55-4944-b6fd-3fceecc381e9",
      "name": "MCP Add Decision Comment",
      "type": "@n8n/n8n-nodes-langchain.mcpClient",
      "typeVersion": 1,
      "position": [
        740,
        620
      ],
      "parameters": {
        "endpointUrl": "={{$vars.EXO_MCP_ENDPOINT}}",
        "authentication": "mcpOAuth2Api",
        "tool": {
          "__rl": true,
          "mode": "id",
          "value": "add_task_comment"
        },
        "inputMode": "json",
        "jsonInput": "={{ { task_id: $json.task_id, text: \"Stamp \" + $json.role + \": \" + $json.decision + ($json.reason ? (\". Reason: \" + $json.reason) : \"\") } }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "0c1f8ed6-0edb-4388-9329-81270cc588fc",
      "name": "Update Approval State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        620
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const input = $('Parse Approval').item.json;\nconst state = $getWorkflowStaticData('global');\nif (!state.wf02Approvals) state.wf02Approvals = {};\nconst key = String(input.task_id) + ':' + String(input.cycle_id);\nif (!state.wf02Approvals[key]) { state.wf02Approvals[key] = { task_id: input.task_id, cycle_id: input.cycle_id, approvals: { artistic: { actor: 'nadia', decision: 'PENDING', reason: '', at: '' }, technical: { actor: 'etienne', decision: 'PENDING', reason: '', at: '' } } }; }\nconst row = state.wf02Approvals[key];\nif (row.approvals[input.role]) { row.approvals[input.role].decision = input.decision; row.approvals[input.role].reason = input.reason || ''; row.approvals[input.role].at = new Date().toISOString(); }\nconst art = row.approvals.artistic?.decision;\nconst tech = row.approvals.technical?.decision;\nconst joinReady = art !== 'PENDING' && tech !== 'PENDING';\nconst bothApproved = art === 'APPROVED' && tech === 'APPROVED';\nreturn [{ json: { task_id: row.task_id, cycle_id: row.cycle_id, joinReady, bothApproved, artistic: row.approvals.artistic, technical: row.approvals.technical } }];"
      }
    },
    {
      "id": "11957881-e158-478b-9d45-3e96f7a56d90",
      "name": "IF Join Ready",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1240,
        620
      ],
      "parameters": {
        "conditions": {
          "options": {
