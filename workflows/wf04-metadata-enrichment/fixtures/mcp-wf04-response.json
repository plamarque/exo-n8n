      {
        "parameters": {
          "jsCode": "const root = items[0].json.content?.[0]?.text;\nconst out = [];\nconst walk = (node) => {\n  if (!node) return;\n  if (Array.isArray(node)) return node.forEach(walk);\n  const id = node.category_id;\n  const label = node.name;\n  if (id != null && label != null) {\n    out.push({\n      category_id: Number(id),\n      category_label: String(label),\n    });\n  }\n  if (Array.isArray(node.sub_categories)) walk(node.sub_categories);\n};\nwalk(root?.sub_categories || root);\nreturn out.map((row) => ({ json: row }));"
        },
