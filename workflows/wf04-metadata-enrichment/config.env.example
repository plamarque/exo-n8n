# Workflow 04 — n8n variables (canonical graph uses these keys only)
# EXO_MCP_ENDPOINT: same key as n8n $vars and optional root .env for deploy-time MCP endpoint injection (docs/DEVELOPMENT.md REST deploy).

EXO_MCP_ENDPOINT=https://exo.example.com/mcp-server/mcp

# Required: must exactly match an eXo space name visible to get_my_spaces (see README + SPEC.technical.md)
EXO_SPACE_NAME=Festival Art2Rue - Documents
