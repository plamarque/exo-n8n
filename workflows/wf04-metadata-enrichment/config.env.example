# Workflow 04 — n8n variables (canonical graph uses these keys only)
# EXO_MCP_ENDPOINT: optional root .env → `npm run generate:workflow-json` (docs/DEVELOPMENT.md).

EXO_MCP_ENDPOINT=https://exo.example.com/mcp-server/mcp

# Display name for tracking + LLM context. Canonical workflow.json does NOT use $vars.EXO_SPACE_NAME;
# Prepare AI Input carries spaceName ={{ "Festival Art2Rue - Documents" }}; generate/deploy rewrites that inner
# string from this key. Bootstrap (fixtures/FIXTURE_BOOTSTRAP_PROMPT.md) uses TARGET_SPACE_DISPLAY_NAME.
EXO_SPACE_NAME=Festival Art2Rue - Documents

# eXo space_id for search_documents (digits only). Canonical List Documents MCP Manual parameters.value.space_id uses a demo literal (1);
# generate/deploy rewrites that field from this key. Populate via bootstrap get_my_spaces (or UI).
WF04_SPACE_ID=1
