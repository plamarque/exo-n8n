# Workflow 03 - .env keys (didactic slice, ADR 0004 - SPEC.technical.md §7)
# Copy these into the repository root `.env`. The canonical workflow.json holds plain
# literals for the demo tenant; REST deploy (`./tools/deploy.sh wf03`) and
# `npm run generate:workflow-json` rewrite each `Prepare Steering Config` Set assignment
# from these values via `applyWf03PrepareSteeringConfigFromEnv`
# (tools/lib/n8n-workflow-deploy-core.mjs). No n8n Variables / `$vars.*` are read at runtime.

EXO_MCP_ENDPOINT=https://exo.example.com/mcp-server/mcp

# Business identifiers (rewritten into the `Prepare Steering Config` Set node)
WF03_SPACE_ID=1
WF03_PROJECT_ID=3
WF03_TEMPLATE_NOTE_ID=25
WF03_REPORTS_PARENT_NOTE_ID=6
WF03_AGENDA_PARENT_EVENT_ID=13
WF03_MEETING_OWNER=Project team
WF03_ATTENDEE_USERNAMES=claire,etienne,louis,nadia,antoine,emma
# Output language imposed on the `Analyze Steering Signals` agent (free-form). The agent
# emits progress_report subsection headings, vigilance titles + decision labels, and the
# three agenda description fields (label_support, label_agenda, outro_text) in this language.
# Typical values: English, Français, Español, Deutsch, ... — defaults to "English" if unset.
WF03_LANGUAGE=English
WF03_STAGNATION_DAYS=3
WF03_BLOCKED_DAYS=5
WF03_OVERLOAD_THRESHOLD=5
