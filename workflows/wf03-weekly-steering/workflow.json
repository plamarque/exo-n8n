    {
      "parameters": {
        "html": "<p><strong>Useful links</strong></p><ul><li><a href=\"{{ $('Prepare Steering Config').item.json.exo_base_url }}/portal/g/:spaces:{{ $('Prepare Steering Config').item.json.space_slug }}/home/tasks/projectDetail/{{ $('Prepare Steering Config').item.json.project_id }}\" target=\"_blank\" rel=\"noopener noreferrer\">Project - task board</a></li><li><a href=\"{{ $('Prepare Steering Config').item.json.exo_base_url }}/portal/g/:spaces:{{ $('Prepare Steering Config').item.json.space_slug }}/home/agenda?parentId={{ $('Prepare Steering Config').item.json.agenda_parent_event_id }}&occurrenceId={{ encodeURIComponent($('Prepare Steering Config').item.json.meeting_start_iso) }}\" target=\"_blank\" rel=\"noopener noreferrer\">Agenda - meeting occurrence</a></li></ul>"
      },
      "id": "c2a100a1-0001-4000-8000-000000000007",
      "name": "HTML Build Annexes Links",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1,
      "position": [
        1948,
        224
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cfg = $('Prepare Steering Config').item.json;\nlet html = $('MCP Get Template Note').item.json.content[0].text.html_content;\n\nhtml = html\n  .replaceAll('[[NOTE_TITLE]]', cfg.note_title)\n  .replaceAll('[[MEETING_DATE]]', cfg.meeting_date)\n  .replaceAll('[[MEETING_OWNER]]', cfg.meeting_owner)\n  .replaceAll('[[NEXT_MEETING_DATE]]', cfg.next_meeting_date)\n  .replaceAll('[[MEETING_DATE_PLUS_2]]', cfg.meeting_date_plus_2);\n\nfunction wrap(start, end, inner) {\n  const a = html.indexOf(start);\n  const b = html.indexOf(end);\n  if (a === -1 || b === -1) return;\n  html = html.slice(0, a) + inner + html.slice(b + end.length);\n}\n\nwrap('[SUGGESTED_AGENDA_START]', '[SUGGESTED_AGENDA_END]', $('HTML Build AI Agenda').item.json.html);\nwrap('[REPORT_AVANCEMENT_START]', '[REPORT_AVANCEMENT_END]', $('Analyze Steering Signals').item.json.output.progress_report);\nwrap('[POINTS_A_DISCUTER_START]', '[POINTS_A_DISCUTER_END]', $('HTML Build AI Watch Items').item.json.html);\nwrap('[ANNEXES_LIENS_START]', '[ANNEXES_LIENS_END]', $('HTML Build Annexes Links').item.json.html);\n\nreturn { json: { html_content: html, note_title: cfg.note_title } };\n"
      },
