    {
      "parameters": {
        "jsonSchemaExample": "{\"suggested_agenda\":[\"Short, actionable point\"],\"progress_report\":\"<p>Concise opener paragraph (1-2 sentences) setting the weekly mood.</p><h4>Notable items</h4><ul><li><strong>/task:123 Sample title</strong> - @owner - <em>HIGH - In Progress</em><br/>One short sentence explaining why this matters this week.</li></ul><h4>Stalled or blocked</h4><ul><li><strong>/task:456 Other title</strong> - @owner - <em>NORMAL - Waiting On</em><br/>Awaiting external validation since Apr 24.</li></ul>\",\"vigilances\":[\"<strong>Short title</strong><br/>One or two sentences of context and stakes. <em>Decision to take:</em> what the meeting must decide.\"],\"summary\":\"Short opener for the meeting\",\"agenda_label_support\":\"Meeting support\",\"agenda_label_agenda\":\"Suggested agenda\",\"agenda_outro_text\":\"Prepared automatically from project 3 tasks.\"}",
        "autoFix": true
