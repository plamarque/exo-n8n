# MCP endpoint used by HTTP Request nodes (single endpoint expecting {tool, arguments})
EXO_MCP_ENDPOINT=https://exo.example.com/mcp
EXO_MCP_TOKEN=replace-me

# REST fallback (used only when create_task_in_project fails)
EXO_REST_BASE_URL=https://exo.example.com/portal/rest
EXO_REST_TOKEN=replace-me

# Functional settings
EXO_PROJECT_NAME=Festival Art2Rue - Operations
EXO_PROJECT_ID=66
EXO_DEFAULT_STATUS_ID=261
EXO_DEFAULT_ASSIGNEE=yann
EXO_WATCHERS=teamlead_it
EXO_ESCALATION_HOURS=2
EXO_ESCALATE_TO=teamlead_it
