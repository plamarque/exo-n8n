# Workflow 01 — n8n variables (canonical graph keys)
# EXO_MCP_ENDPOINT matches n8n $vars.EXO_MCP_ENDPOINT and optional repository root .env (deploy injects the || "..." fallback from root .env — see docs/DEVELOPMENT.md REST deploy).

EXO_MCP_ENDPOINT=https://exo.example.com/mcp-server/mcp

# Target board / project id for create_task_in_project (graph fallback 3 if unset)
WF01_PROJECT_ID=3
