# Workflow 01 — n8n variables (canonical graph keys)
# EXO_MCP_ENDPOINT: optional root .env → run `npm run generate:workflow-json` to write MCP Client endpointUrl into workflow.json (see docs/DEVELOPMENT.md).

EXO_MCP_ENDPOINT=https://exo.example.com/mcp-server/mcp

# Reference tenant project id (tutorial WF01 hardcodes project_id in MCP Create Task manual parameters).
# Set when bootstrapping fixtures or other tooling; the canonical tutorial graph does not read this from n8n $vars.
WF01_PROJECT_ID=3
