    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this email and decide if it is clearly actionable.\nSubject: {{ $json.subject }}\nSender: {{ $json.sender.address }}\nBody: {{ $json.content.body }}\n\nReturn only the structured fields requested.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are the triage agent for Art2Rue festival emails. Create a task only if the email is clearly actionable. If it is unclear or informational, set action_required=false and response_expected=false. Expected fields: action_required (boolean), response_expected (boolean), action_confidence (0..1), assignee_username (louis|claire|lucie), priority (LOW|NORMAL|HIGH|URGENT), task_title, summary."
        }
      },
