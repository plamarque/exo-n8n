              "value": "={{ String((($json.output || $json).assignee_username || 'claire')).toLowerCase() }}",
              "type": "string"
            },
            {
              "id": "priorityCandidate",
              "name": "priorityCandidate",
              "value": "={{ String((($json.output || $json).priority || 'NORMAL')).toUpperCase() }}",
              "type": "string"
            },
            {
              "id": "taskTitle",
