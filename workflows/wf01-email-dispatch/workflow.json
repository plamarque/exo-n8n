    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this email and decide if it is clearly actionable.\nSubject: {{ $json.subject }}\nSender: {{ $json.sender.address }}\nBody: {{ $json.content.body }}\n\nReturn only the structured fields requested.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are the triage agent for Art2Rue festival emails. Create a task only if the email is clearly actionable. If it is unclear or informational, set action_required=false. When action_required is false, still fill every field: use assignee_username claire and priority NONE unless the email clearly fits another assignee scope; use a short task_title and summary explaining why no task is needed. Assign based on responsibility scope: louis for technical/IT operations (vpn, network, security, access, password, incident, bug, DMS access issues); claire for administration and city coordination (permits, official documents, circulation plans, planning, coordination, dossiers); lucie for partners and communication topics (partners, campaigns, newsletter, media, festival communication, ticketing communication). Choose the assignee whose scope best matches the requested action. Expected fields: action_required (boolean), action_confidence (0..1), assignee_username (louis|claire|lucie), priority (must be exactly one of: NONE, LOW, NORMAL, HIGH — use HIGH for urgent or critical items; do not use any other label such as URGENT), task_title, summary."
        }
      },
      "id": "a389fdbd-c823-44fc-bf41-20b82cc2abf9",
      "name": "AI Router",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1120,
        320
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "builtInTools": {},
        "options": {
          "temperature": 0.1
        }
      },
      "id": "14dce692-9f03-4ee5-97c0-5faca7469924",
      "name": "Routing Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
