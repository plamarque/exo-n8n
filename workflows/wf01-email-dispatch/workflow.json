    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const esc = (v) => String(v ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\\\"/g, '&quot;');\n\nconst excerpt = String($json.body || '').replace(/\\s+/g, ' ').slice(0, 400);\n\nreturn {\n  ...$json,\n  senderSafe: esc($json.sender),\n  subjectSafe: esc($json.subject),\n  summarySafe: esc($json.summary || 'Summary not provided'),\n  nextActionSafe: esc($json.nextAction || 'Analyze and update status'),\n  assigneeLabelSafe: esc($json.assigneeLabel || $json.resolvedAssignee),\n  resolvedAssigneeSafe: esc($json.resolvedAssignee),\n  resolvedPrioritySafe: esc($json.resolvedPriority),\n  actionConfidenceSafe: esc($json.actionConfidence),\n  rationaleSafe: esc($json.rationale || 'AI decision'),\n  excerptSafe: esc(excerpt),\n};"
      },
      "id": "9ff29148-4ada-4dab-999e-c649d2408061",
      "name": "Prepare Safe Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2592,
        320
      ]
    },
    {
      "parameters": {
        "operation": "generateHtmlTemplate",
        "template": "<div><p><strong>Email from:</strong> {{$json.senderSafe}}<br/><strong>Subject:</strong> {{$json.subjectSafe}}</p><h4>Context</h4><p>{{$json.summarySafe}}</p><h4>Expected action</h4><p>{{$json.nextActionSafe}}</p><h4>AI decision</h4><ul><li><strong>Assignee:</strong> {{$json.assigneeLabelSafe}} ({{$json.resolvedAssigneeSafe}})</li><li><strong>Priority:</strong> {{$json.resolvedPrioritySafe}}</li><li><strong>Actionable confidence:</strong> {{$json.actionConfidenceSafe}}</li><li><strong>Rationale:</strong> {{$json.rationaleSafe}}</li></ul><h4>Email excerpt</h4><blockquote>{{$json.excerptSafe}}</blockquote></div>"
      },
