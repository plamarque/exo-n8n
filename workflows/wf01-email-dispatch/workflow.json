    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"action_required\": {\n      \"type\": \"boolean\",\n      \"description\": \"True only if the email clearly requires someone to act.\"\n    },\n    \"action_confidence\": {\n      \"type\": \"number\",\n      \"minimum\": 0,\n      \"maximum\": 1,\n      \"description\": \"Confidence that action_required is correct.\"\n    },\n    \"assignee_username\": {\n      \"type\": \"string\",\n      \"enum\": [\"louis\", \"claire\", \"lucie\"],\n      \"description\": \"Responsible user; when not actionable, still output one value (e.g. claire).\"\n    },\n    \"priority\": {\n      \"type\": \"string\",\n      \"enum\": [\"NONE\", \"LOW\", \"NORMAL\", \"HIGH\"],\n      \"description\": \"Task priority; must match MCP create_task_in_project (no URGENT or other labels).\"\n    },\n    \"task_title\": {\n      \"type\": \"string\",\n      \"description\": \"Short task title when actionable; otherwise a minimal placeholder is acceptable.\"\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"Brief summary of the email and decision.\"\n    }\n  },\n  \"required\": [\n    \"action_required\",\n    \"action_confidence\",\n    \"assignee_username\",\n    \"priority\",\n    \"task_title\",\n    \"summary\"\n  ]\n}"
      },
